<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>InscripcionOPSU</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <CodePage>65001</CodePage>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AssemblyTitle>Inscripción Universitaria · OPSU y Flotantes</AssemblyTitle>
    <Product>Control de Estudios · Inscripción por Trayecto</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="8.4.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\public\img\logo-uptll.jpg" Link="Recursos\logo-uptll.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
